#!/bin/sh
# Cross compiler for the H700 through zig (pip install ziglang), targeting
# glibc 2.31 like the bullseye device build. zig spells CPUs with
# underscores and has no -mtune, so GCC-style flags are translated.
for a in "$@"; do
	shift
	case "$a" in
	-mcpu=*) set -- "$@" "$(echo "$a" | tr - _ | sed 's/^_mcpu=/-mcpu=/')" ;;
	-mtune=*) ;;
	*) set -- "$@" "$a" ;;
	esac
done
exec python3 -m ziglang cc -target aarch64-linux-gnu.2.31 -Wno-error=date-time "$@"
